{
  "name": "spacecraft-mock-interface",
  "version": "1.0.0",
  "description": "A mocked, interactive control interface for a fictional spacecraft",
  "keywords": [
    "react",
    "vite",
    "spacecraft",
    "mock",
    "sci-fi"
  ],
  "homepage": "https://github.com/AlexisRoe/spacecraft-mock-interface#readme",
  "bugs": {
    "url": "https://github.com/AlexisRoe/spacecraft-mock-interface/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexisRoe/spacecraft-mock-interface.git"
  },
  "license": "MIT",
  "author": "Alexis Roehrling",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/ui": "5.0.0",
    "jsdom": "26.0.0",
    "typescript": "5.7.3",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0"
  }
}
